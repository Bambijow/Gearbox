{
  "schema_version": 1,
  "policy": "Single declarative source for specialist routing, implicit consequence surfaces, static model/effort identities, gate triggers/artifact needs, scheduling, controlled review fusion, adaptive depth, read-only packing, and safe telemetry bounds.",
