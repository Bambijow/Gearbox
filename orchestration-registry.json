  "quality_profiles": {
    "dev": {
      "probe_depth": "focused",
      "state_matrix": "changed-only",
      "review_depth": "focused",
      "notes": "Fast local iteration; required correctness/safety gates remain required."
    },
    "standard": {
      "probe_depth": "representative",
      "state_matrix": "material-states",
      "review_depth": "standard",
      "notes": "Default Gearbox balance."
    },
    "release": {
      "probe_depth": "broad",
      "state_matrix": "representative-plus-edge",
      "review_depth": "release",
      "notes": "Shipping confidence across representative journeys."
    },
    "critical": {
      "probe_depth": "strict",
      "state_matrix": "risk-expanded",
      "review_depth": "strict",
      "notes": "High consequence paths; broader evidence and fresh adjudication."
    }
  },
  "gates": {
    "SLOP_GATE": {
      "trigger_task_kinds": [
        "web-design",
        "creative-web"
      ],
      "probe_group": "experience",
      "skill": "web-design",
      "probe_needs": [
        "screenshot"
      ]
    },
    "INTERACTION_GATE": {
      "trigger_surfaces": [
        "interactive_ui"
      ],
      "trigger_task_kinds": [
        "creative-web"
      ],
      "probe_group": "experience",
      "skill": "web-design",
      "probe_needs": [
        "interaction",
        "screenshot"
      ]
    },
    "A11Y_GATE": {
      "trigger_surfaces": [
        "user_ui"
      ],
      "probe_group": "experience",
      "skill": "a11y-audit",
      "probe_needs": [
        "accessibility",
        "interaction"
      ]
    },
    "DESIGN_SYSTEM_GATE": {
      "trigger_surfaces": [
        "shared_design_system"
      ],
      "probe_group": "repository",
      "skill": "design-system",
      "probe_needs": []
