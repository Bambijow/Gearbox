  "scheduler": {
    "priority_policy": "critical-path-then-descendants-then-risk",
    "batch_same_shape": true,
    "max_batch_members": 6,
    "conflict_policy": "owned-path-prefix-overlap"
  },
  "adaptive_routing": {
    "mode": "advisory",
    "min_samples": 5,
    "min_success_rate": 0.8,
    "safety_ceiling_surfaces": [
      "security_boundary",
      "persistence",
      "public_api",
      "production_config"
    ],
    "never_override_registered_specialist_routes": true,
    "never_promote_to_frontier_from_telemetry": true
  }
