    "motion-design": {
      "router": "game_asset"
    },
    "review-3d": {
      "router": "game_asset"
    },
    "web-design": {
      "router": "web_design",
      "creative": false
    },
    "creative-web": {
      "router": "web_design",
      "creative": true
    },
    "design-system": {
      "router": "product_quality"
    },
    "a11y-audit": {
