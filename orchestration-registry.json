  "quality_profiles": {
    "dev": {
      "probe_depth": "focused",
      "state_matrix": "changed-only",
      "review_depth": "focused",
      "notes": "Fast local iteration; required correctness/safety gates remain required."
    },
    "standard": {
      "probe_depth": "representative",
      "state_matrix": "material-states",
      "review_depth": "standard",
      "notes": "Default Gearbox balance."
    },
    "release": {
      "probe_depth": "broad",
      "state_matrix": "representative-plus-edge",
      "review_depth": "release",
      "notes": "Shipping confidence across representative journeys."
    },
    "critical": {
      "probe_depth": "strict",
      "state_matrix": "risk-expanded",
      "review_depth": "strict",
      "notes": "High consequence paths; broader evidence and fresh adjudication."
    }
  },
  "gates": {
    "SLOP_GATE": {
      "trigger_task_kinds": [
        "web-design",
        "creative-web"
      ],
      "probe_group": "experience",
      "skill": "web-design",
      "probe_needs": [
        "screenshot"
      ]
    },
    "INTERACTION_GATE": {
      "trigger_surfaces": [
        "interactive_ui"
      ],
      "trigger_task_kinds": [
        "creative-web"
      ],
      "probe_group": "experience",
      "skill": "web-design",
      "probe_needs": [
        "interaction",
        "screenshot"
      ]
    },
    "A11Y_GATE": {
      "trigger_surfaces": [
        "user_ui"
      ],
      "probe_group": "experience",
      "skill": "a11y-audit",
      "probe_needs": [
        "accessibility",
        "interaction"
      ]
    },
    "DESIGN_SYSTEM_GATE": {
      "trigger_surfaces": [
        "shared_design_system"
      ],
      "probe_group": "repository",
      "skill": "design-system",
      "probe_needs": []
    },
    "CONTENT_GATE": {
      "trigger_surfaces": [
        "ux_copy"
      ],
      "probe_group": "experience",
      "skill": "content-design",
      "probe_needs": [
        "dom",
        "screenshot"
      ]
    },
    "PERF_GATE": {
      "trigger_surfaces": [
        "performance_sensitive",
        "creative_runtime"
      ],
      "probe_group": "experience",
      "skill": "experience-perf",
      "probe_needs": [
        "performance",
        "network",
        "console"
      ]
    },
    "ART_DIRECTION_GATE": {
      "trigger_surfaces": [
        "art_direction",
        "multi_asset"
      ],
      "probe_group": "asset",
      "skill": "art-direction",
      "probe_needs": []
    },
    "AUDIO_GATE": {
      "trigger_surfaces": [
        "audio"
      ],
      "probe_group": "runtime",
      "skill": "audio-design",
      "probe_needs": [
        "playback"
      ]
    },
    "PLAYTEST_GATE": {
      "trigger_surfaces": [
        "level"
      ],
      "probe_group": "gameplay",
      "skill": "level-design",
      "probe_needs": [
        "playback",
        "interaction"
      ]
    },
    "VISUAL_REGRESSION_GATE": {
      "trigger_surfaces": [
        "user_ui"
      ],
      "requires_flag": "baseline_exists",
      "probe_group": "experience",
      "skill": "visual-regression",
      "probe_needs": [
        "screenshot",
        "dom"
      ]
    },
    "CREATIVE_GATE": {
      "trigger_task_kinds": [
        "creative-web"
      ],
      "probe_group": "experience",
      "skill": "creative-web",
      "probe_needs": [
        "screenshot",
        "interaction",
        "playback"
      ]
    }
  },
  "task_surfaces": {
    "asset-image": [
      "visual_asset"
    ],
    "pixel-art": [
      "visual_asset"
    ],
    "model-3d": [
      "asset_3d"
    ],
    "motion-design": [
      "visual_asset"
    ],
    "review-3d": [
      "asset_3d"
    ],
    "web-design": [
      "user_ui"
    ],
    "creative-web": [
      "user_ui",
      "interactive_ui",
      "creative_runtime",
      "performance_sensitive"
    ],
    "design-system": [
      "shared_design_system"
    ],
    "a11y-audit": [
      "user_ui"
    ],
    "visual-regression": [
      "user_ui"
    ],
    "content-design": [
      "ux_copy"
    ],
    "experience-perf": [
      "performance_sensitive"
    ],
    "art-direction": [
      "art_direction"
    ],
    "audio-design": [
      "audio"
    ],
    "level-design": [
      "level"
    ],
    "video-create": [
      "visual_asset",
      "multi_asset",
      "performance_sensitive"
    ]
  },
  "scheduler": {
    "priority_policy": "critical-path-then-descendants-then-risk",
    "batch_same_shape": true,
    "max_batch_members": 6,
    "conflict_policy": "owned-path-prefix-overlap"
  },
  "adaptive_routing": {
    "mode": "advisory",
    "min_samples": 5,
    "min_success_rate": 0.8,
    "safety_ceiling_surfaces": [
      "security_boundary",
      "persistence",
      "public_api",
      "production_config"
    ],
    "never_override_registered_specialist_routes": true,
    "never_promote_to_frontier_from_telemetry": true
  },
  "review_fusion": {
    "enabled": true,
    "max_risk": "medium",
    "allowed_profiles": [
      "dev",
      "standard"
    ],
    "excluded_task_kinds": [
      "creative-web",
      "security-audit"
    ],
    "packs": [
      {
        "id": "ui-quality",
        "gates": [
          "SLOP_GATE",
          "INTERACTION_GATE",
          "A11Y_GATE",
          "CONTENT_GATE"
        ],
        "provider": "claude",
        "model": "sonnet",
        "effort": "high",
        "agent": "quality-gate-reviewer",
        "require_shared_probe_group": "experience",
        "min_members": 2,
        "max_members": 4
      }
    ]
  },
  "quality_depth": {
    "mode": "escalate-only",
    "repair_cycle_threshold": 2,
    "silent_finding_min_profile": "release",
    "integration_repair_step": 1,
    "high_risk_min_profile": "release",
    "critical_risk_profile": "critical",
    "never_remove_required_gates": true
  },
  "readonly_packing": {
    "enabled": true,
    "allowed_kinds": [
      "research",
      "review",
      "gate",
      "analysis",
      "static-check",
      "route"
    ],
    "max_members": 6,
    "require_same_provider": true,
    "require_same_model": true,
    "require_same_effort": true,
    "require_same_context_fingerprint": true,
    "forbid_independent_judgment": true
  },
  "test_impact": {
    "mode": "rank-only",
    "min_samples": 5,
    "bucket_depth": 2,
    "never_drop_required_checks": true
  },
  "repo_facts_cache": {
    "enabled": true,
    "cache_scope": "user-xdg-per-repo",
    "supported_kinds": [
      "package-json",
      "tsconfig-json",
      "pyproject-toml",
      "cargo-toml",
      "go-mod",
      "workflow-yaml",
      "requirements"
    ]
  },
  "video_models": {
    "policy": "cheapest-capable-with-budget-cap-and-explicit-paid-approval",
    "pricing_verified_at": "2026-10-24",
    "models": [
      {
        "id": "fal-ai/kling-video/v2.5-turbo/pro/image-to-video",
        "tier": "simple",
        "usd_per_second": 0.07,
        "features": [
          "image_to_video",
          "single_shot"
        ],
        "durations": [
          5,
          10
        ],
        "resolutions": [
          "720p"
        ],
        "input_image_field": "image_url",
        "note": "Budget hero/simple motion. Confirm duration and resolution restrictions at dispatch."
      },
      {
        "id": "wan/v2.6/image-to-video",
        "tier": "standard",
        "usd_per_second_by_resolution": {
          "720p": 0.1,
          "1080p": 0.15
        },
        "features": [
          "image_to_video",
          "single_shot",
          "multi_shot"
        ],
        "durations": [
          5,
          10,
          15
        ],
        "resolutions": [
          "720p",
          "1080p"
        ],
        "input_image_field": "image_url"
      },
      {
        "id": "fal-ai/veo3.1/first-last-frame-to-video",
        "tier": "premium",
        "usd_per_second_by_resolution": {
          "720p": 0.2,
          "1080p": 0.2
        },
        "features": [
          "image_to_video",
          "first_last_frame",
          "cinematic"
        ],
        "durations": [
          4,
          6,
          8
        ],
        "resolutions": [
          "720p",
          "1080p"
        ],
        "input_image_field": "first_frame_url",
        "note": "Premium frame control; validate live schema and pricing."
      }
    ],
    "guardrails": {
      "image_required": true,
      "max_estimated_usd_default": 1.5,
      "require_explicit_spend_approval": true,
      "require_fresh_price_check": true
    }
  }
}
