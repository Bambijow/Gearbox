      },
      "comp_generator": {
        "engine": "codex",
        "model": "gpt-6.1-sol",
        "effort_by_scope": {
          "refine": "medium",
          "surface": "medium",
          "redesign": "high",
          "creative": "high"
        }
      },
      "builder": {
        "engine": "codex",
        "model": "gpt-6.1-sol",
        "effort_by_scope": {
          "refine": "medium",
          "surface": "medium",
          "redesign": "high",
          "creative": "high"
        }
      },
      "reviewer": {
        "refine": {
          "engine": "claude",
          "model": "sonnet",
