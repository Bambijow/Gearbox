{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "result"
        ]
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integration_base_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_sha": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "summary",
    "integration_base_sha",
    "head_sha",
    "changed_files",
    "verification",
    "risks",
    "notes"
  ]
}
