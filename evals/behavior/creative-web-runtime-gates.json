    },
    {
      "type": "regex",
      "value": "(?i)(mobile|touch)"
    },
    {
      "type": "regex",
      "value": "(?i)(reduced.motion|fallback|WebGL fails|keyboard)"
    },
    {
      "type": "regex",
      "value": "(?i)(performance|frame|measure|trace)"
