{
  "name": "3D modeling keeps Opus direction and Astra review",
  "context_files": [
    "skills/model-3d/SKILL.md",
    "references/model-3d-workflow.md"
  ],
  "prompt": "A codex-heavy run needs a game-ready 3D prop. Which model owns creative/technical direction, when may Codex participate, and what mandatory review follows?",
  "assertions": [
    {
      "type": "regex",
      "value": "(?i)(claude.*opus.*5\\.5|opus.*5\\.5)"
    },
    {
      "type": "regex",
      "value": "(?i)(codex.*gpt-6\\.1.*sol|gpt-6\\.1.*sol|delegate)"
    },
    {
      "type": "regex",
      "value": "(?i)(gpt-6.*astra|astra)"
    },
    {
      "type": "regex",
      "value": "(?i)(direction|own|accept|topology|rig)"
    },
    {
      "type": "max_chars",
      "value": 2200
    }
  ]
}
