{
  "name": "3D modeling forces Opus 5.5",
  "context_files": [
    "skills/model-3d/SKILL.md",
    "references/model-3d-workflow.md"
  ],
  "prompt": "A codex-heavy run needs a game-ready 3D prop and Blender is available. Which model/provider owns actual modeling, and what review follows?",
