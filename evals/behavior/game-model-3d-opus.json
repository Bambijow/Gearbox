    {
      "type": "regex",
      "value": "(?i)(claude.*opus.*5\\.5|opus.*5\\.5)"
    },
    {
      "type": "regex",
      "value": "(?i)(gpt-6.*astra|astra)"
    },
    {
      "type": "not_regex",
      "value": "(?i)codex.*(model|create).*3d"
    },
    {
      "type": "max_chars",
      "value": 2000
    }
  ]
}
