{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gearbox Gate Result",
  "type": "object",
  "required": [
    "schema_version",
    "gate",
    "status",
    "scope",
    "findings",
    "evidence",
    "run_id",
    "quality_plan_id",
    "input_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "gate": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "REPAIR",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "details": {
      "type": "object"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "quality_plan_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              0,
              null
            ]
          }
        }
      }
    }
  ]
}
