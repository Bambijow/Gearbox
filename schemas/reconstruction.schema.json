{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gearbox:reconstruction:1",
  "title": "Gearbox behavioral reconstruction bundle",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "source",
            "behavior",
            "interface",
            "binary",
            "api"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "enum": [
            "runnable",
            "artifact-only",
            "recordings-only"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "version",
        "fingerprint",
        "availability"
      ]
    },
    "target": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "project": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "project",
            "revision"
          ]
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "static-analysis",
              "runtime",
              "recording",
              "trace",
              "test"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "string",
            "enum": [
              "bounded",
              "partial",
              "unknown"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "sha256",
          "source_fingerprint",
          "coverage",
          "limitations"
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "inferred",
              "unknown"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "statement",
          "material",
          "status",
          "evidence_ids",
          "limitations"
        ]
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "setup": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "oracle": {
            "type": "string",
            "minLength": 1
          },
          "reference_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "normalizations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "comparison": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "claim_ids",
          "setup",
          "actions",
          "expected",
          "oracle",
          "reference_evidence_ids",
          "normalizations",
          "comparison"
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "preserve",
              "adapt",
              "discard",
              "defer"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "target_behavior": {
            "type": "string",
            "minLength": 1
          },
          "scenario_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "claim_id",
          "disposition",
          "reason",
          "scenario_ids"
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "question",
          "blocking",
          "claim_ids"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "question",
    "scope",
    "source",
    "limitations",
    "evidence",
    "claims",
    "scenarios",
    "decisions",
    "unknowns"
  ]
}
