{
  "description": "Enforce Gearbox's delegated control-plane boundary for orchestrated commands.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/orchestrator_guard.py\" reset",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "(?:gearbox:)?(?:setup|wayfinder|brainstorm|shape|spec-to-issue|spec-to-issues|issue|loop|flow|plan|build|debug|optimize|dogfood|asset-image|pixel-art|model-3d|review-3d|test-harden|simplify|review|security-audit|learn|clean-solutions|skill-doctor|ship|retro|resume|continue-pr)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/migrate_legacy.py\" --hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "(?:gearbox:)?(?:issue|loop|flow|brainstorm|resume|continue-pr)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/orchestrator_guard.py\" activate",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/orchestrator_guard.py\" check",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/orchestrator_guard.py\" deactivate",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/orchestrator_guard.py\" deactivate",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
